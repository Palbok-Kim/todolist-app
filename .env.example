# 복사해서 .env로 쓴다. 실제 비밀 값은 커밋하지 않는다 (SO-02, SO-03)
# 키 설명: docs/9-design.md 6장

# backend: 로컬에 설치한 PostgreSQL 17 (localhost:5432)
DATABASE_URL=postgresql://todo:change-me@localhost:5432/todolist
NODE_ENV=development
PORT=3000
PG_POOL_MAX=10
# Vite 개발 서버 프록시(같은 장비)만 신뢰한다 (SO-16)
TRUST_PROXY=loopback
# scrypt 동시 처리용 libuv 스레드 풀 (9-design.md 3장)
UV_THREADPOOL_SIZE=4

# 서명 키: base64url, 디코딩 후 48바이트 이상. 생성 방법은 9-design.md 5.3
JWT_SECRET=change-mechange-mechange-mechange-mechange-mechange-mechange-mechange-me
CSRF_SECRET=change-mechange-mechange-mechange-mechange-mechange-mechange-mechange-me

# 시드 계정 비밀번호 (SO-11)
SEED_PASSWORD=change-me-change-me
