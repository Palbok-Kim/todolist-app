{
  "name": "todolist-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "test": "node --env-file-if-exists=../.env --import ./test/helpers/env.js --test-global-setup=./test/helpers/setup.js --test-concurrency=1 --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10"
  }
}
